# Copy to backend/.env for local runs. On Cloud Run these are set by infra/deploy.sh (secrets via Secret Manager).
ENVIRONMENT=local
DATABASE_URL=sqlite:///./fundtrace.db
# Cloud SQL (MySQL 8) via the Cloud Run unix socket:
# DATABASE_URL=mysql+pymysql://fundtrace:PASSWORD@/fundtrace?unix_socket=/cloudsql/PROJECT:REGION:INSTANCE&charset=utf8mb4
SEED_ON_START=true
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
DEMO_PASSWORD=Investigate@2026
SHOW_DEMO_CREDENTIALS=true

# Vertex AI / Gemini (uses Application Default Credentials; no API key)
GCP_PROJECT=
GCP_LOCATION=asia-south1
GEMINI_LOCATION=global
LLM_ENABLED=true
GEMINI_FAST_MODELS=gemini-2.5-flash
GEMINI_PRO_MODELS=gemini-2.5-pro,gemini-2.5-flash
LLM_TIMEOUT_SECONDS=45
LLM_DAILY_BUDGET_USD=20
LLM_CASE_BUDGET_USD=1

# Evidence storage: local | gcs
STORAGE_BACKEND=local
GCS_BUCKET=

# Telemetry: none | console | gcp
OTEL_EXPORTER=none
LOG_LEVEL=INFO

# Sign-in and MFA
# FIREBASE_PROJECT_ID=           # enables "Sign in with Google" (Firebase Auth); users must already exist (username = email)
# FIREBASE_API_KEY=              # Firebase web API key (public config, not a secret)
MFA_REQUIRED_ROLES=              # e.g. supervisor,admin — these roles must enrol an authenticator app; others may opt in

# Field-level encryption (AES-256-GCM). Local: "kid:<base64 32 bytes>" pairs, first encrypts (rotation).
# Generate: python -c "import os,base64;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
# Without it, local runs use a development key derived from JWT_SECRET. In the cloud a key is required:
# FIELD_KEY_KMS_NAME + FIELD_KEY_WRAPPED (set by infra/deploy.sh).
# FIELD_ENCRYPTION_KEYS=

# DLP: local (built-in detectors) | gcp (Cloud DLP; reads images and PDFs) | off
DLP_BACKEND=local

# Ledger ingest via Pub/Sub push (set by infra/deploy.sh). Statement upload (admin) works without it.
# PUBSUB_PUSH_AUDIENCE=https://<service-url>/api/ingest/pubsub
# PUBSUB_PUSH_SERVICE_ACCOUNT=fundtrace-ledger-push@<project>.iam.gserviceaccount.com
