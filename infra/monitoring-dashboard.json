{
  "displayName": "FundTrace — AI & service health",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 6, "height": 4,
        "widget": {
          "title": "Gemini calls per minute",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/fundtrace_ai_calls\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM"}
                }
              },
              "plotType": "LINE"
            }]
          }
        }
      },
      {
        "xPos": 6, "width": 6, "height": 4,
        "widget": {
          "title": "Gemini failures per minute (shown to users as \"Not analysed\")",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/fundtrace_ai_failures\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM"}
                }
              },
              "plotType": "LINE"
            }]
          }
        }
      },
      {
        "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Request latency p95 (Cloud Run)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"fundtrace\"",
                  "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_95", "crossSeriesReducer": "REDUCE_MAX"}
                }
              },
              "plotType": "LINE"
            }]
          }
        }
      },
      {
        "xPos": 6, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Requests by response class",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"fundtrace\"",
                  "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM",
                                  "groupByFields": ["metric.label.\"response_code_class\""]}
                }
              },
              "plotType": "STACKED_BAR"
            }]
          }
        }
      },
      {
        "yPos": 8, "width": 12, "height": 3,
        "widget": {
          "title": "AI cost, hallucination rate and evaluation results are tracked in-app on the AI Ops page (per call, node, case and day).",
          "text": {"content": "Open the deployed app → AI Ops. Every Gemini call is also a structured log line (jsonPayload.event=\"ai_call\") with node, model, tokens, cost_usd and latency_ms, correlated to Cloud Trace.", "format": "MARKDOWN"}
        }
      }
    ]
  }
}
